# War-Room Environment Configuration

# Provider selection: scripted | openai_compatible | azure_openai | ollama
LLM_PROVIDER=scripted

# OpenAI / OpenAI-Compatible Endpoint (used if LLM_PROVIDER=openai_compatible)
OPENAI_API_KEY=mock-key-for-offline
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Confidence threshold for human escalation (default 0.55)
CONFIDENCE_THRESHOLD=0.55

# Maximum evidence request loops by Incident Commander
MAX_LOOPS=2

